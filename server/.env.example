# Port the API listens on
PORT=5000

# MongoDB connection string.
#   Local MongoDB:  mongodb://127.0.0.1:27017/notes_app
#   MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/notes_app
# Leave it EMPTY to use the built-in embedded MongoDB (no install needed,
# data is saved in server/.data so it survives restarts).
MONGO_URI=

# Secret used to sign login tokens - change this to any long random string
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend URL allowed by CORS
CLIENT_URL=http://localhost:5173
